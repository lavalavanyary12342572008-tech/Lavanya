
#include <stdio.h>

int main() {
    int choice;
    int n, i;
    int marks[100];
    int total = 0;
    float average;
    int highest, lowest;
    int pass = 0, fail = 0;

    printf("====================================\n");
    printf("     STUDENT MANAGEMENT SYSTEM\n");
    printf("====================================\n");

    printf("Enter number of students (1-100): ");
    scanf("%d", &n);

    if (n < 1 || n > 100) {
        printf("Invalid number of students!\n");
        return 0;
    }

    for (i = 0; i < n; i++) {
        printf("Enter marks for student %d: ", i + 1);
        scanf("%d", &marks[i]);

        if (marks[i] < 0 || marks[i] > 100) {
            printf("Invalid marks! Enter marks from 0 to 100.\n");
            return 0;
        }

        total = total + marks[i];
    }

    highest = marks[0];
    lowest = marks[0];

    for (i = 0; i < n; i++) {
        if (marks[i] > highest) {
            highest = marks[i];
        }

        if (marks[i] < lowest) {
            lowest = marks[i];
        }

        if (marks[i] >= 35) {
            pass++;
        } else {
            fail++;
        }
    }

    average = (float) total / n;

    printf("\n========== RESULT REPORT ==========\n");
    printf("Total Students : %d\n", n);

    for (i = 0; i < n; i++) {
        printf("Student %d Marks: %d\n", i + 1, marks[i]);

        if (marks[i] >= 35) {
            printf("Result: PASS\n");
        } else {
            printf("Result: FAIL\n");
        }
    }

    printf("\nTotal Marks    : %d\n", total);
    printf("Average Marks  : %.2f\n", average);
    printf("Highest Marks  : %d\n", highest);
    printf("Lowest Marks   : %d\n", lowest);
    printf("Students Passed: %d\n", pass);
    printf("Students Failed: %d\n", fail);

    printf("\n========== GRADE REPORT ==========\n");

    if (average >= 90) {
        printf("Grade: A+\n");
    } else if (average >= 80) {
        printf("Grade: A\n");
    } else if (average >= 70) {
        printf("Grade: B\n");
    } else if (average >= 60) {
        printf("Grade: C\n");
    } else if (average >= 35) {
        printf("Grade: D\n");
    } else {
        printf("Grade: F\n");
    }

    printf("\nThank you for using the program!\n");
    printf("Keep Learning C Programming.\n");
    printf("====================================\n");

    return 0;
}
